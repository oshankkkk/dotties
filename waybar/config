{
  "layer": "top",
  "position": "top",
  "height": 28,

  "modules-left": [
    "clock"
  ],

  "modules-center": [
    "memory"
  ],

  "modules-right": [
    "network",
    "pulseaudio"
  ],

  "clock": {
    "format": "  {:%H:%M}",
    "tooltip-format": "{:%A, %d %B %Y}"
  },

  "memory": {
    "interval": 5,
    "format": "󰍛  {}%"
  },

  "network": {
    "format-wifi": "  {signalStrength}%",
    "format-ethernet": "󰈀  Connected",
    "format-disconnected": "󰖪  Offline",
    "tooltip-format": "{ifname} via {gwaddr}"
  },

  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰝟  Muted",
    "format-icons": {
      "default": [
        "",
        "",
        ""
      ]
    }
  }
}
